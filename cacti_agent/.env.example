# Satu konfigurasi untuk launcher, sync DATIN, dan collector. Jangan upload .env.
HDWORK_BASE_URL=https://serverhdwork.telkomakses-area3.id
DATIN_CACTI_AGENT_API_KEY=

# Endpoint collector boleh berbeda dari API sync; API key tetap terpisah.
HDWORK_URL=https://serverhdwork.telkomakses-area3.id/api/cactys/cacti
HDWORK_API_KEY=
COLLECTOR_NAME=PC_MONITOR_CACTY

SYNC_INTERVAL_SECONDS=600
COLLECTOR_INTERVAL_SECONDS=300
WORKER_RESTART_SECONDS=10

# Akun sync wajib punya akses edit DATIN. Collector DATIN memakai akun ini
# jika DATIN_* di bawah kosong. Sesi HTTP kedua aplikasi tetap terpisah.
CACTI_SBS_BASE_URL=http://10.96.33.156/ont
CACTI_SBS_USERNAME=
CACTI_SBS_PASSWORD=
CACTI_SBU_BASE_URL=http://10.100.2.234/ont
CACTI_SBU_USERNAME=
CACTI_SBU_PASSWORD=

# Opsional: akun read-only collector DATIN yang berbeda.
DATIN_SBS_BASE_URL=
DATIN_SBS_USERNAME=
DATIN_SBS_PASSWORD=
DATIN_SBU_BASE_URL=
DATIN_SBU_USERNAME=
DATIN_SBU_PASSWORD=

# Konfigurasi NODEB collector lama dipertahankan; algoritma tidak diubah.
NODEB_SBS_BASE_URL=
NODEB_SBS_USERNAME=
NODEB_SBS_PASSWORD=
NODEB_SBU_BASE_URL=
NODEB_SBU_USERNAME=
NODEB_SBU_PASSWORD=
